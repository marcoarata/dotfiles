# YADR 2027 — .gitignore
# NOTA: lazy-lock (nvim lazy-lock.json) YES, it is versioned -> do not ignore.

# automatic yadr install/migrate backups
*.yadr-backup-*
*.bak
*~
*.orig
*.rej

# node / packs
node_modules/
dist/
.npm/
.pnpm-store/

# local: personal overrides that are never version-controlled
.yadr.local
.config/yadr/local/
custom/local/

# secrets (classic .secrets model -> local/)
.secrets
*.key
*.pem

# editores / OS
.DS_Store
Thumbs.db
*.swp
*.swo
.netrwhist

# caches
.cache/
*.log

