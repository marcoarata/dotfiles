#!/usr/bin/env bash
# YADR 2027 — bin/yadr
# CLI: install update doctor diff backup runtime version benchmark
# Non-destructive without confirmation. Abstracts runtimes via `runtime` (mise inside,
# never exposed as public API).
set -euo pipefail

# YADR_HOME: resolves symlinks of the binary ITSELF (yadr also lives in
# ~/.local/bin/yadr → $YADR_HOME/bin/yadr). cd -P alone is not enough: the
# symlink is the file, not a dir in the path; it must be followed via readlink.
_SRC="${BASH_SOURCE[0]}"
while [[ -L "$_SRC" ]]; do
  _D="$(cd -- "$(dirname -- "$_SRC")" && pwd -P)"
  _SRC="$(readlink "$_SRC")"
  [[ "$_SRC" != /* ]] && _SRC="$_D/$_SRC"
done
BIN_DIR="$(cd -- "$(dirname -- "$_SRC")" && pwd -P)"
YADR_HOME="$(cd -- "${BIN_DIR}/.." && pwd -P)"
unset _SRC _D
# platform/*.sh installs the CLI into ~/.local/bin (mise, zoxide); doctor and
# subcommands must see them even if the interactive PATH lacks them yet.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="$HOME/.local/share/mise/shims:$PATH" ;;
esac
export PATH
VERSION_FILE="${YADR_HOME}/VERSION"
export BACKUP_ROOT="${HOME}/.local/state/yadr/backups"
export STATE_DIR="${HOME}/.local/state/yadr"

# --- colors (tty only) ---
if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GREEN=$'\033[32m'
  YELLOW=$'\033[33m'; BLUE=$'\033[34m'; RESET=$'\033[0m'
else
  BOLD=''; DIM=''; RED=''; GREEN=''; YELLOW=''; BLUE=''; RESET=''
fi

OK="${GREEN}✓${RESET}"; WARN="${YELLOW}⚠${RESET}"; FAIL="${RED}✗${RESET}"
info()  { printf '%s %s\n' "${BLUE}»${RESET}" "$*"; }
ok()    { printf '%s %s\n' "$OK" "$*"; }
warn()  { printf '%s %s\n' "$WARN" "$*"; }
err()   { printf '%s %s\n' "$FAIL" "$*" >&2; }
die()   { err "$*"; exit 1; }
have()  { command -v "$1" >/dev/null 2>&1; }

# --- macOS (BSD) portability / bash 3.2 ---
# cp -a does not exist on macOS: cp -Rp preserves mode/dates and symlinks.
cp_preserve() { cp -Rp "$@" 2>/dev/null; }
# Portable nanoseconds: BSD date has no %N (prints "...N" literally, which
# breaks arithmetic). Case-match filters %, N and any non-digit output.
now_ns() {
  local t
  t="$(date +%s%N 2>/dev/null)"
  case "$t" in
    ''|*%*|*N*|*[^0-9]*) if command -v python3 >/dev/null 2>&1; then python3 -c 'import time;print(time.time_ns())'
      else printf '%s000000000' "$(date +%s)"; fi ;;
    *) printf '%s' "$t" ;;
  esac
}
# timeout(1) does not exist on base macOS: use gtimeout when present, else run directly.
run_timeout() {
  local secs="$1"; shift
  if command -v timeout >/dev/null 2>&1; then timeout "$secs" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then gtimeout "$secs" "$@"
  else "$@"; fi
}

version_str() { [[ -f "$VERSION_FILE" ]] && tr -d ' \t\n' <"$VERSION_FILE" || echo "0.0.0-unknown"; }

confirm() {
  # confirm "prompt" — honors global --yes. Returns 0 when accepted.
  local prompt="$1"
  [[ "${YADR_YES:-0}" == "1" ]] && return 0
  printf '%s [y/N]: ' "$prompt" >&2
  local ans=""; IFS= read -r ans || true
  [[ "$ans" == "y" || "$ans" == "Y" || "$ans" == "yes" ]]
}

# --- managed pairs: "relative_source:absolute_dest" ---
# When the source is missing from the repo (e.g. partial checkout), report and skip.
managed_pairs() {
  cat <<EOF
bin/yadr:${HOME}/.local/bin/yadr
shell/zshrc:${HOME}/.zshrc
shell/aliases.zsh:${HOME}/.config/yadr/aliases.zsh
shell/damoekri.zsh:${HOME}/.config/yadr/damoekri.zsh
shell/keybindings.zsh:${HOME}/.config/yadr/keybindings.zsh
shell/runtime.zsh:${HOME}/.config/yadr/runtime.zsh
git/gitconfig:${HOME}/.gitconfig
tmux/tmux.conf:${HOME}/.tmux.conf
nvim:${HOME}/.config/nvim
runtime/mise.toml:${HOME}/.config/mise/config.toml
EOF
}


# Command implementations live in lib/ (sourced into this same shell,
# so behavior is identical to a single file). YADR_LIB_DIR override
# exists only for tests.
YADR_LIB_DIR="${YADR_LIB_DIR:-${BIN_DIR}/lib}"
for _lib in install recover doctor runtime benchmark; do
  # shellcheck disable=SC1090
  source "${YADR_LIB_DIR}/${_lib}.sh" || { echo "cannot load lib/${_lib}.sh" >&2; exit 1; }
done
unset _lib
do_diff() {
  local changed=0 total=0
  while IFS=: read -r rel dst; do
    [[ -z "$rel" ]] && continue
    total=$((total+1))
    local src="${YADR_HOME}/${rel}"
    printf '\n%s%s%s\n' "$BOLD" "${rel} → ${dst}" "$RESET"
    if [[ ! -e "$src" && ! -L "$src" ]]; then
      warn "  (missing from checkout — skipped)"
      continue
    fi
    if [[ ! -e "$dst" && ! -L "$dst" ]]; then
      warn "  would create ${dst} (new)"
      changed=$((changed+1)); continue
    fi
    if [[ -d "$src" && -d "$dst" && ! -L "$src" && ! -L "$dst" ]]; then
      if diff -r -q "$src" "$dst" >/dev/null 2>&1; then ok "  unchanged"; else changed=$((changed+1)); diff -r -u "$src" "$dst" 2>/dev/null | head -n 80 || true; fi
    elif [[ -f "$src" && -f "$dst" && ! -L "$dst" ]]; then
      if cmp -s "$src" "$dst"; then ok "  unchanged"; else changed=$((changed+1)); diff -u "$dst" "$src" | head -n 80 || true; fi
    else
      # symlink or other type: compare link target
      local dlink
      dlink="$(readlink "$dst" 2>/dev/null || echo "?")"
      if [[ "$dlink" == "$src" ]]; then ok "  unchanged (symlink → repo)"; else changed=$((changed+1)); warn "  would change: now '${dlink}', would become '${src}'"; fi
    fi
  done < <(managed_pairs)
  printf '\n%s\n' "${DIM}diff: ${changed} with changes. Nothing modified (read-only).${RESET}"
}

usage() {
  cat <<EOF
${BOLD}YADR 2027 $(version_str)${RESET} — ${DIM}${YADR_HOME}${RESET}
usage: yadr <command> [args]

  install [profile]  base + profile (core|node|typescript|ruby|python|rust|lazygit|development|macos-extras; no profile = core)
  update             git pull + runtime upgrades (with backup and confirmation)
  doctor             checks the environment with hints (pass/warn/fail)
  diff               shows what would change, modifies nothing
  backup             copies current dotfiles to ~/.local/state/yadr/backups/<timestamp>/
  uninstall [--dry-run] [--purge]  reverts install and restores your backup
  migrate [--dry-run] imports classic YADR customization (idempotent)
  pack list          lists installable optional packs
  pack add <name>    installs a pack (same as its install profile)
  theme [list|use <name>|current]  Solarized background (light|dark|none, default none)
  gitsigns [on|off|status]  Git signs in Neovim (default: off)
  runtime current    active runtimes
  runtime list       installed runtimes
  runtime use t@v   activates global runtime (e.g. node@24)
  runtime doctor     runtime backend health
  version            prints version
  benchmark shell|nvim|cd|prompt  measures startup (shell/nvim) or cd/prompt cost

options: --yes/-y (skip confirmations), --help/-h
EOF
}

# --- parse global flags ---
ARGS=()
for a in "$@"; do
  case "$a" in --yes|-y) YADR_YES=1 ;; --help|-h) usage; exit 0 ;; *) ARGS+=("$a") ;; esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

cmd="${1:-}"; shift || true
case "$cmd" in
  install)   do_install "${1:-core}" ;;
  update)    do_update ;;
  doctor)    do_doctor ;;
  diff)      do_diff ;;
  backup)    do_backup ;;
  uninstall) do_uninstall "$@" ;;
  migrate)   do_migrate "${1:-}" ;;
  pack)
    sub="${1:-}"; shift || true
    case "$sub" in
      list) do_pack_list ;;
      add)  do_pack_add "${1:-}" ;;
      *) usage; die "pack: unknown subcommand '${sub}' (list|add)" ;;
    esac ;;
  gitsigns)
    sub="${1:-}"; shift || true
    case "$sub" in
      on|off) cmd_gitsigns "$sub" ;;
      status|"") cmd_gitsigns status ;;
      *) usage; die "gitsigns: unknown subcommand '${sub}' (on|off|status)" ;;
    esac ;;
  runtime)
    sub="${1:-}"; shift || true
    case "$sub" in
      current) cmd_runtime_current ;;
      list)    cmd_runtime_list ;;
      use)     cmd_runtime_use "${1:-}" ;;
      doctor)  cmd_runtime_doctor ;;
      *) usage; die "runtime: unknown subcommand '${sub}' (current|list|use|doctor)" ;;
    esac ;;
  theme)
    sub="${1:-}"; shift || true
    case "$sub" in
      use) cmd_theme use "${1:-}" ;;
      *)   cmd_theme "$sub" ;;
    esac ;;
  version)   version_str; echo ;;
  benchmark) do_benchmark "${1:-shell}" ;;
  ""|--help|-h|help) usage ;;
  *) usage; die "unknown command: $cmd" ;;
esac
